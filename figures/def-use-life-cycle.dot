digraph DefUse
{

InScopeUndefined -> LiveDef      [label="initialize"];

InScopeUndefined -> DefNoLongerUsed [label="unused\ninitialization"];

LiveDef -> DefNoLongerUsed      [label="last use\nof def"];

DefNoLongerUsed -> LiveDef      [label=" new def"];

DefNoLongerUsed -> DefNoLongerUsed  [label="unused\nassignment"];

DefNoLongerUsed -> OutOfScope      [label="end of scope"];

InScopeUndefined -> OutOfScope     [label=" unused\nvar"];

}
