From 4bc28a323b5555aa4d6890b0618005625ce69a72 Mon Sep 17 00:00:00 2001
From: "J. Ryan Stinnett" <jryans@gmail.com>
Date: Mon, 11 Aug 2025 13:20:57 +0100
Subject: [PATCH 5/5] Skip credential tests, need interactive session

---
 t/t0300-credentials.sh      | 7 +++++++
 t/t0301-credential-cache.sh | 7 +++++++
 t/t0302-credential-store.sh | 7 +++++++
 3 files changed, 21 insertions(+)

diff --git a/t/t0300-credentials.sh b/t/t0300-credentials.sh
index 3485c0534e..eae1e80bd1 100755
--- a/t/t0300-credentials.sh
+++ b/t/t0300-credentials.sh
@@ -1,12 +1,19 @@
 #!/bin/sh
 
 test_description='basic credential helper tests'
 . ./test-lib.sh
+
+if ! test_have_prereq INTERACTIVE
+then
+	skip_all='skipping credential tests, requires interactive session'
+	test_done
+fi
+
 . "$TEST_DIRECTORY"/lib-credential.sh
 
 test_expect_success 'setup helper scripts' '
 	cat >dump <<-\EOF &&
 	whoami=$(echo $0 | sed s/.*git-credential-//)
 	echo >&2 "$whoami: $*"
 	OIFS=$IFS
 	IFS==
diff --git a/t/t0301-credential-cache.sh b/t/t0301-credential-cache.sh
index 698b7159f0..46535e0413 100755
--- a/t/t0301-credential-cache.sh
+++ b/t/t0301-credential-cache.sh
@@ -1,12 +1,19 @@
 #!/bin/sh
 
 test_description='credential-cache tests'
 . ./test-lib.sh
+
+if ! test_have_prereq INTERACTIVE
+then
+	skip_all='skipping credential tests, requires interactive session'
+	test_done
+fi
+
 . "$TEST_DIRECTORY"/lib-credential.sh
 
 test -z "$NO_UNIX_SOCKETS" || {
 	skip_all='skipping credential-cache tests, unix sockets not available'
 	test_done
 }
 
 uname_s=$(uname -s)
diff --git a/t/t0302-credential-store.sh b/t/t0302-credential-store.sh
index 716bf1af9f..c4c3515e7e 100755
--- a/t/t0302-credential-store.sh
+++ b/t/t0302-credential-store.sh
@@ -1,12 +1,19 @@
 #!/bin/sh
 
 test_description='credential-store tests'
 . ./test-lib.sh
+
+if ! test_have_prereq INTERACTIVE
+then
+	skip_all='skipping credential tests, requires interactive session'
+	test_done
+fi
+
 . "$TEST_DIRECTORY"/lib-credential.sh
 
 helper_test store
 
 test_expect_success 'when xdg file does not exist, xdg file not created' '
 	test_path_is_missing "$HOME/.config/git/credentials" &&
 	test -s "$HOME/.git-credentials"
 '
-- 
